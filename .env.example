# Mini Cloud Image Studio — Konfigurasi Environment
# Salin file ini menjadi .env dan sesuaikan nilainya dengan lingkungan Anda.
#
# Cara penggunaan:
#   cp .env.example .env
#   (Lalu edit .env sesuai kebutuhan)

# ─────────────────────────────────────────────
# ENDPOINT CLOUD (DEFAULT: MINISTACK — open-source Python clone dari LocalStack)
# Ministack (RECOMMENDED) : http://localhost:4566   (pip install ministack)
# LocalStack              : http://localhost:4566   (kompatibel 100% same API)
# MinIO                   : http://localhost:9000   (HANYA S3 — DynamoDB butuh service lain)
# ─────────────────────────────────────────────
ENDPOINT_URL=http://localhost:4566

# ─────────────────────────────────────────────
# KREDENSIAL AWS / CLOUD LOKAL
# Untuk Ministack, LocalStack, dan MinIO (mode development), nilai "test" sudah cukup.
# Untuk AWS nyata, ganti dengan Access Key ID dan Secret Access Key yang valid.
#
# CATATAN: Aplikasi juga MENERIMA kedua format nama env ini untuk backward compat:
#   - AWS_ACCESS_KEY      (old format, fallback)
#   - AWS_SECRET_KEY      (old format, fallback)
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─────────────────────────────────────────────
# REGION AWS
# Ministack & LocalStack menggunakan region virtual — bebas pilih.
# us-east-1 adalah default yang selalu tersedia dan paling banyak didukung.
# ─────────────────────────────────────────────
AWS_REGION=us-east-1

# ─────────────────────────────────────────────
# S3 SIGNING & ADDRESSING (untuk kompatibilitas penuh dengan Ministack/MinIO)
# - s3v4        : Signature Version 4 (default — kompatibel Ministack/LocalStack/MinIO)
# - addressing_style = "path" (URL: http://host/bucket/key) — direkomendasikan untuk localhost
#               = "virtual" (URL: http://bucket.host/key) — butuh DNS setup
# ─────────────────────────────────────────────
S3_SIGNATURE_VERSION=s3v4
S3_ADDRESSING_STYLE=path

# ─────────────────────────────────────────────
# KONFIGURASI S3 (Ministack)
# Nama bucket tempat gambar disimpan.
# Bucket akan dibuat OTOMATIS jika belum ada (idempoten).
# ─────────────────────────────────────────────
S3_BUCKET_NAME=mini-cloud-studio

# ─────────────────────────────────────────────
# KONFIGURASI DYNAMODB (Ministack)
# Nama tabel DynamoDB untuk menyimpan metadata gambar.
# Tabel akan dibuat OTOMATIS jika belum ada (idempoten).
# ─────────────────────────────────────────────
DYNAMODB_TABLE_NAME=image-metadata
